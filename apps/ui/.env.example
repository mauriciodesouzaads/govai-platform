# GovAI UI — build-time public configuration.
#
# ⚠ EVERY VITE_* VALUE IS INLINED INTO THE CLIENT BUNDLE AND IS THEREFORE PUBLIC.
# Never put an API key, provider key, token or any other secret in this file or in any
# VITE_* variable. The GovAI API key is entered by the user at runtime and lives only in
# browser memory (see src/lib/session/).

# API base URL. Empty (the default) means SAME-ORIGIN: the reverse proxy serves the UI under
# /app/ and the API under /v1/* on one origin. Set only when the UI is served from a
# different origin than the API — that also requires API_CORS_ORIGINS on the API side.
VITE_GOVAI_API_BASE_URL=

# Commit SHA of the build, displayed in the footer as the audit stamp of any screenshot.
# Unset renders an explicit "unavailable" marker rather than a fabricated value.
VITE_GOVAI_BUILD_SHA=

# Dev-server only (NOT a VITE_ variable, never inlined): where `pnpm --filter @govai/ui dev`
# proxies the API prefixes. Defaults to http://127.0.0.1:8080.
# GOVAI_UI_DEV_API_TARGET=http://127.0.0.1:8080
