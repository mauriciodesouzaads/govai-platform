# GovAI Platform — example environment. Copy to .env and fill locally.
# NEVER commit .env. NEVER commit real KMS_DEV_SEED.

NODE_ENV=development

# --- KMS (development only) ---
# Generate locally (NEVER commit with a real value):
#   openssl rand -hex 32 | xargs printf 'KMS_DEV_SEED=%s\n' >> .env
KMS_DEV_SEED=
GOVAI_KMS_PROVIDER=dev

# --- Postgres ---
# Generate the govai_app password locally (NEVER commit with a real value):
#   openssl rand -hex 24 | xargs printf 'GOVAI_DB_APP_PASSWORD=%s\n' >> .env
# Then build DATABASE_URL using that password (URL-encode special chars).
# bootstrap.sql reads GOVAI_DB_APP_PASSWORD via session GUC; the migration runner
# (`pnpm --filter @govai/api run migrate`) injects it into the bootstrap session.
# See docs/runbooks/db-roles-production.md.
GOVAI_DB_APP_PASSWORD=
DATABASE_URL=
# Admin URL — superuser used to run bootstrap + migrations only. Generate the
# postgres password the same way:
#   openssl rand -hex 24 | xargs printf 'POSTGRES_PASSWORD=%s\n' >> .env
POSTGRES_PASSWORD=
DATABASE_ADMIN_URL=

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=8080
API_HOST=0.0.0.0
API_CORS_ORIGINS=http://localhost:3000
API_CORS_CREDENTIALS=false

# --- JWT ---
JWT_ISSUER=https://govai.local
JWT_AUDIENCE=govai-api
# Public key (PEM) used to verify JWTs. Algorithm whitelist hardcoded server-side.
JWT_PUBLIC_KEY_PEM=

# --- Provider credentials (NEVER commit real values) ---
# These are set per-tenant in DB at runtime, not env. Env is only for live tests.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- OTel ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=govai-api
OTEL_TRACES_SAMPLER_ARG=1.0

# --- Live tests ---
GOVAI_LIVE_TESTS=0
