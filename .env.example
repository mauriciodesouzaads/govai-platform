# GovAI Platform — example environment. Copy to .env and fill locally.
# NEVER commit .env. NEVER commit real KMS_DEV_SEED.

NODE_ENV=development

# --- KMS (development only) ---
# Generate locally (NEVER commit with a real value):
#   openssl rand -hex 32 | xargs printf 'KMS_DEV_SEED=%s\n' >> .env
KMS_DEV_SEED=
GOVAI_KMS_PROVIDER=dev

# --- Postgres ---
# Generate the govai_app password locally (NEVER commit with a real value):
#   openssl rand -hex 24 | xargs printf 'GOVAI_DB_APP_PASSWORD=%s\n' >> .env
# Then build DATABASE_URL using that password (URL-encode special chars).
# bootstrap.sql reads GOVAI_DB_APP_PASSWORD via session GUC; the migration runner
# (`pnpm --filter @govai/api run migrate`) injects it into the bootstrap session.
# See docs/runbooks/db-roles-production.md.
GOVAI_DB_APP_PASSWORD=
DATABASE_URL=
# Admin URL — superuser used to run bootstrap + migrations only. Generate the
# postgres password the same way:
#   openssl rand -hex 24 | xargs printf 'POSTGRES_PASSWORD=%s\n' >> .env
POSTGRES_PASSWORD=
DATABASE_ADMIN_URL=

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=8080
API_HOST=0.0.0.0
API_CORS_ORIGINS=http://localhost:3000
API_CORS_CREDENTIALS=false

# --- JWT ---
JWT_ISSUER=https://govai.local
JWT_AUDIENCE=govai-api
# Public key (PEM) used to verify JWTs. Algorithm whitelist hardcoded server-side.
JWT_PUBLIC_KEY_PEM=

# --- Provider credentials (NEVER commit real values) ---
# Production/pilot resolve provider keys per-tenant from the DB (no env fallback).
# In dev/test operational modes these env vars are the runtime fallback used by
# the tenant credential resolver when no tenant credential exists
# (apps/api/src/pipeline/provider-credentials.ts); they are also used by live
# provider tests. Never the production credential source.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- OTel / observability ---
# UNSET (empty) => metrics export is a no-op and boot is byte-identical (the default;
# CI keeps this empty). To export to the LOCAL collector stack (infra/docker-compose.yml:
# otel-collector + prometheus + grafana — see docs/runbooks/observability-local.md), set:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# The exporter POSTs to <endpoint>/v1/metrics. Do NOT set a non-empty default here.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=govai-api
OTEL_TRACES_SAMPLER_ARG=1.0

# --- Evidence gauges (optional; EP-EVIDENCE-GAUGE-WIRING) ---
# The govai_evidence_* gauges emit per-org from app boot ONLY when BOTH
# OTEL_EXPORTER_OTLP_ENDPOINT (above) AND the enumerator URL below are set. Unset =>
# the wiring is fully off and boot is byte-identical. This uses the LEAST-privilege
# govai_evidence_enumerator role (enumerate-only: SELECT on govai.orgs, nothing else) —
# NOT the app/admin credential; leaking it enumerates org UUIDs and nothing more.
# Provision by generating a password locally (NEVER commit a real value):
#   openssl rand -hex 24 | xargs printf 'GOVAI_DB_EVIDENCE_ENUMERATOR_PASSWORD=%s\n' >> .env
# The migration runner injects it into the bootstrap session, which then grants the role
# LOGIN (unset => the role stays NOLOGIN/unreachable). Then build the URL with that password.
GOVAI_DB_EVIDENCE_ENUMERATOR_PASSWORD=
GOVAI_EVIDENCE_ENUMERATOR_URL=

# Grafana admin password for the local observability stack (refuse-if-missing when
# `docker compose up grafana`). Generate locally; NEVER commit a real value:
#   openssl rand -hex 24 | xargs printf 'GRAFANA_ADMIN_PASSWORD=%s\n' >> .env
GRAFANA_ADMIN_PASSWORD=

# --- Live tests ---
GOVAI_LIVE_TESTS=0
# Budget acknowledgement for the OPTIONAL live provider-spend test (EP-E2E-USER Part B).
# Absent/0 => those tests SKIP (CI never sets it). Set to 1 ONLY to deliberately opt into
# a << $0.01 real call (max_tokens:1, one per provider); real ANTHROPIC_API_KEY/
# OPENAI_API_KEY must also be present.
GOVAI_LIVE_PROVIDER_BUDGET_OK=0
